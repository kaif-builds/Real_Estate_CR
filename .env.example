# === Database ===
# Local dev: SQLite (default, no setup required — just leave unset or use:)
# DATABASE_URL=sqlite+aiosqlite:///./realestate_crm.db
#
# Production (managed Postgres — use the pooler/transaction-mode endpoint):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/realestate_crm

# === Auth ===
SECRET_KEY=change-me-in-production

# === CORS ===
CORS_ORIGINS=http://localhost:3000

# === Backend ===
DEBUG=true

# === Frontend (server-side, for Next.js API proxy) ===
# Local dev: http://localhost:8000
# Vercel: set to the deployed backend URL
BACKEND_URL=http://localhost:8000
